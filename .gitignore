# Rebuild these from versioned raw data and source.
/data/processed/*
!/data/processed/.gitkeep
/artifacts/models/*
!/artifacts/models/.gitkeep
/artifacts/metadata/*
!/artifacts/metadata/.gitkeep

# Environment secrets and editor/OS files
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
